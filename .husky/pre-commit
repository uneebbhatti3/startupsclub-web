branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ] || [ "$branch" = "integration" ]; then
  echo "Commit blocked: do not commit directly to '$branch'."
  echo "Create a branch named dev/<your-name> and open a pull request instead."
  exit 1
fi

if ! echo "$branch" | grep -Eq '^dev/[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "Commit blocked: branch '$branch' does not match dev/<name> (lowercase letters, digits, hyphens)."
  echo "Example: dev/uneeb. Rename with: git branch -m dev/<your-name>"
  exit 1
fi

npx lint-staged
